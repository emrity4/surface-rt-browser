<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="Supermium.Sideload"
            Publisher="CN=Supermium Publisher"
            Version="1.0.144.0" />
  <Properties>
    <DisplayName>Supermium Browser</DisplayName>
    <PublisherDisplayName>Supermium</PublisherDisplayName>
    <Logo>Assets\Square150x150Logo.png</Logo>
    <Description>Supermium Chromium browser packaged as a sideloadable APPX.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="chrome.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Supermium Browser"
                          Description="Supermium Chromium browser"
                          BackgroundColor="#2b5797"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
<Page
    x:Class="SurfaceRtBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,8,8,4" Background="#1f1f1f">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;" Margin="0,0,6,0" Click="Back_Click" />
            <TextBox x:Name="AddressBar" Grid.Column="1"
                     PlaceholderText="Enter a URL"
                     KeyDown="AddressBar_KeyDown" />
            <Button x:Name="GoButton" Grid.Column="2" Content="Go" Margin="6,0,0,0" Click="Go_Click" />
            <Button x:Name="ForwardButton" Grid.Column="3" Content="&#xE72A;" Margin="6,0,0,0" Click="Forward_Click" />
        </Grid>

        <WebView x:Name="Browser" Grid.Row="1" />
    </Grid>
</Page>